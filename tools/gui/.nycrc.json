{
  "$schema": "https://json.schemastore.org/nycrc",
  "extension": [".js", ".cjs", ".mjs", ".ts", ".tsx", ".jsx", ".vue"],
  "include": ["src/**"],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test-d.ts",
    "src/**/*.spec.ts",
    "src/**/__tests__/**",
    "src/**/*.generated.ts",
    "src/**/*.d.ts"
  ]
}
