; Resolution-time half of the supply-chain floor: npm will not build a tree from a version
; published less than a day ago. The number is in days, and it is the same floor the gate
; enforces over the committed lock — see FLOOR in tools/supplychain/release_age.py.
;
; This is ergonomics, not enforcement. It stops a fresh version being picked by accident during
; `npm install` or `npm update`; `npm ci` installs from the lock without resolving, so it is
; unaffected. The enforcement is the gate, because a rule over a committed lock is monotone and
; a rolling resolution window is not.
;
; Cannot be combined with `before`, which states an exact date instead.
min-release-age=1

; The toolchain half: npm refuses to install, or to write the lock, on any Node or npm other than
; `engines` in package.json — the one declaration CI (`node-version-file`) and the Dockerfile
; (held to it by tests/architecture/test_toolchain_is_declared_once.py) also follow. A lock written
; by one npm major and read by another is not a lock: npm 12 wrote range-keyed overrides that npm 10
; resolved differently, and every CI job that installs the frontend failed after a release push.
engine-strict=true
