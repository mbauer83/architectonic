{
  "abbreviation": "STPA",
  "name": "STPA Analysis",
  "frontmatter_schema": {
    "type": "object",
    "required": [
      "title",
      "status",
      "concern_class"
    ],
    "properties": {
      "title": {
        "type": "string"
      },
      "status": {
        "type": "string",
        "enum": [
          "draft",
          "in-progress",
          "complete",
          "archived"
        ]
      },
      "concern_class": {
        "type": "string",
        "enum": [
          "safety",
          "security",
          "privacy",
          "operational"
        ]
      },
      "analysis_scope": {
        "type": "string"
      }
    }
  },
  "required_sections": [
    "Purpose and Scope",
    "Losses",
    "Hazards",
    "Control Structure",
    "Unsafe Control Actions",
    "Loss Scenarios",
    "Assurance Constraints",
    "References"
  ],
  "suggested_connections": [
    "@all"
  ]
}
